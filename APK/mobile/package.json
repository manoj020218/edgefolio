    "@jenix/cap-face-liveness": "file:./native-plugins/cap-face-liveness",
    "@jenix/cap-lifecycle": "file:../../EMS/Plugins/cap-lifecycle",
    "@jenix/cap-location": "file:../../EMS/Plugins/cap-location",
    "@jenix/cap-push": "file:../../EMS/Plugins/cap-push",
    "@jenix/cap-thermal-printer": "file:../../EMS/Plugins/cap-thermal-printer",
