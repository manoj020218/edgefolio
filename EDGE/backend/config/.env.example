NODE_ENV=development
HOST=127.0.0.1
PORT=7001
JWT_SECRET=change-me-in-production
EDGEFOLIO_DB_PATH=
CLOUD_SYNC_BASE_URL=https://edgefolio.iotsoft.in/api/v1

# Unique ID for this EDGE installation — becomes the FRP subdomain
# e.g. jenix-mumbai → jenix-mumbai.edgefolio.iotsoft.in
EDGE_ID=edgefolio-local

# Set to true after configuring frp-client-config.ini
FRP_ENABLED=false
SCHEDULERS_ENABLED=true
SYNC_INTERVAL_MINUTES=240
SYNC_RUN_ON_STARTUP=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RUN_ON_STARTUP=false
BACKUP_KEEP_LOCAL_FILES=30
CLEANUP_INTERVAL_HOURS=12
LOG_RETENTION_DAYS=30
PAYROLL_CHECK_INTERVAL_MINUTES=60
PAYROLL_RUN_DAY=1
PAYROLL_RUN_HOUR=2
