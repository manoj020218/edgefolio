{
  "name": "edgefolio",
  "version": "1.0.2",
  "description": "EDGEFOLIO — Offline-first Payroll & Attendance for Indian SMEs",
  "main": "electron/main.js",
  "private": true,
  "author": {
    "name": "IOTSoft",
    "email": "iotsoft.in@gmail.com"
  },
  "scripts": {
    "backend": "node backend/index.js",
    "init-db": "node scripts/init-database.js",
    "generate:qr": "node scripts/generate-qr-code.js",
    "python:face:test": "python python/face_recognition_service.py --test",
    "python:face": "python python/face_recognition_service.py",
    "dev:ui": "npm run dev --prefix frontend",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -n UI,Electron -c cyan,yellow \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:stack": "concurrently -n Backend,UI,Electron -c green,cyan,yellow \"npm:backend\" \"npm:dev:ui\" \"npm:dev:electron\"",
    "build:ui": "npm run build --prefix frontend",
    "build:exe": "npm run build:ui && electron-builder --win",
    "build:portable": "npm run build:ui && electron-builder --win portable",
    "check:backend": "node --check backend/index.js && node --check backend/server.js"
  },
  "dependencies": {
    "aedes": "^0.51.3",
    "better-sqlite3": "^11.9.1",
    "cors": "^2.8.5",
    "electron-updater": "^6.1.8",
    "express": "^4.21.2",
    "firebase-admin": "^12.3.0",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.15.1",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "in.iotsoft.edgefolio",
    "productName": "EDGEFOLIO",
    "copyright": "Copyright © 2026 IOTSoft",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "scripts/reset-admin-password.js",
      "node_modules/**/*",
      "package.json",
      "!node_modules/.cache/**/*",
      "!frontend/node_modules/**/*",
      "!frontend/src/**/*"
    ],
    "extraResources": [
      { "from": "scripts/RESET-ADMIN-PASSWORD.bat", "to": "RESET-ADMIN-PASSWORD.bat" }
    ],
    "directories": {
      "output": "../dist-exe",
      "buildResources": "electron/assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EDGEFOLIO",
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "manoj020218",
      "repo": "edgefolio",
      "releaseType": "release"
    }
  }
}
