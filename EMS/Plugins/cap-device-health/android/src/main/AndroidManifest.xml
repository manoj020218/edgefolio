<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application>
        <receiver
            android:name="com.jenix.cap.devicehealth.DeviceHealthRecoverReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jenix.cap.lifecycle.RECOVER_HEARTBEAT" />
                <action android:name="com.jenix.cap.push.REQUEST_DEVICE_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
