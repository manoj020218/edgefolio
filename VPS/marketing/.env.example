# Billing platform API base — the marketing site proxies /api/onboard signup requests here.
BILLING_API_BASE=https://iotsoft.in

# Google OAuth Client ID for the "Sign in with Google" quick-fill button on /onboard.
# Only the client ID is needed — we verify Google ID tokens server-side (google-auth-library),
# not a full OAuth redirect/code-exchange flow, so no client secret is required here.
# Leave unset to hide the Google button entirely (it degrades gracefully).
GOOGLE_CLIENT_ID=
