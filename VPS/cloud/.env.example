# EdgeFolio Cloud — copy to .env on the server (never commit .env).
# Every address lives here, so moving to another VPS = new .env + nginx + DNS, no code change.

NODE_ENV=production
PORT=3090
HOST=127.0.0.1

# Public address the app and EDGE use. Today a path on the marketing domain (existing SSL cert);
# later can become e.g. https://cloud.edgefolio.iotsoft.in — only this line and nginx change.
PUBLIC_BASE_URL=https://edgefolio.iotsoft.in/cloud

# Own database on the shared MongoDB (4.4). Add user:password@ if Mongo auth is enabled.
MONGO_URL=mongodb://127.0.0.1:27017/edgefolio_cloud
MONGO_POOL_SIZE=5

# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# IoT billing platform (organisation registration, early-access plan, usage). Filled in Phase 4.
BILLING_API_URL=
BILLING_API_KEY=

# Only if punch photos are ever enabled for an organisation.
FILE_STORE_DIR=

# Requests slower than this are logged and counted on /health (VPS move trigger watches it).
SLOW_REQUEST_MS=500

# Nightly encrypted backup (deploy/backup.sh). install-backup-cron.sh generates the passphrase.
BACKUP_PASSPHRASE=
BACKUP_DIR=/root/backups/edgefolio-cloud
BACKUP_KEEP_DAYS=30
